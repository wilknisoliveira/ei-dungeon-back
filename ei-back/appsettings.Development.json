{
  "PostgresConnection": {
    "PostgresConnectionString": "ENVIRONMENT_ABOUT_STRING_CONNECTION"
  },
  "Cors": {
    "AllowedOrigins": ""
  },
  "HealthChecks-UI": {
    "HealthChecks": [
      {
        "Name": "Infrastructure",
        "Uri": "/health"
      }
    ]
  },
  "TokenConfigurations": {
    "Audience": "ei-dungeon-web",
    "Issuer": "ei-dungeon-back",
    "Secret": "MY_SUPER_SECRET_KEY_ADD_MORE_WORDS_TO_INCREASE_THE_NUMBER_OF_BYTES",
    "Minutes": 30,
    "DaysToExpiry": 7
  },
  "Logging": {
    "Console": {
      "TimestampFormat": "[yyyy-MM-dd HH:mm:ss] "
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "keys": {
    "OpenRouterApiKey": "APIKEY"
  },
  "Gateways": {
    "OpenRouterApi": "https://openrouter.ai/api/v1"
  },
  "GenAISettings": {
    "AiModel": "gpt-3.5-turbo-0125"
  },
  "PlayOptions": {
    "LimitTokens": 14000,
    "SummaryMaxTokens": 4000
  },
  "Features": {
    "BypassLlmGenerator": true,
    "BypassCharacterCount": 500
  }
}
