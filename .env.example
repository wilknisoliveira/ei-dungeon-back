# PostgreSQL development database
POSTGRES_DB=ei_db
POSTGRES_USER=ei_dungeon
POSTGRES_PASSWORD=change-this-development-password
POSTGRES_PORT=5432

# ASP.NET Core backend
BACKEND_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
CORS_ALLOWED_ORIGINS=http://localhost:8000

# Application secrets - replace these values in .env
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
JWT_SECRET=development-only-jwt-secret-change-me-before-use-0123456789-abcdef
